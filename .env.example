# Copy to .env.local (gitignored) and export it, e.g. `set -a; . ./.env.local; set +a`.
# scenewise reads only SCENEWISE_* variables, from the environment; it loads no file.
# Harness runs and CI reach no paid API: leave the keys empty there.

# --- scenewise (the skeleton's settings; ARCHITECTURE.md §10) ---
# SCENEWISE_MEDIA__FFMPEG=ffmpeg
# SCENEWISE_MEDIA__FFPROBE=ffprobe
# SCENEWISE_SERVICE__STATE_PREFIX=file:///var/lib/scenewise/state
# SCENEWISE_INPUTS__LOCAL_ROOTS=["/srv/media"]
# SCENEWISE_LOG__FORMAT=console

# --- Claude Haiku (roadmap item 2; U5). Provider and region are deployment settings. ---
# First-party Anthropic API: the key is needed only for this provider.
ANTHROPIC_API_KEY=
# Vertex AI (Expause: the EU multi-region). Credentials come from Application Default
# Credentials (`gcloud auth application-default login`), never from this file.
GOOGLE_CLOUD_PROJECT=
CLOUD_ML_REGION=
