{
  "version": 1,
  "projectName": "scenewise",
  "defaultBranch": "dev",
  "protectedBranches": [
    "main",
    "dev",
    "publish"
  ],
  "stateDir": "sdlc-harness/",
  "appDir": ".",
  "scriptsDir": "harness-scripts",
  "githooksDir": "githooks",
  "agentModel": "opus",
  "pushEnvPath": ".claude/push-notify.env",
  "detection": {
    "preset": "python-package",
    "signal": "python-package:packaging-manifest",
    "evidence": "pyproject.toml",
    "commandFamily": "python",
    "review": {
      "verdict": "applied",
      "rationale": "Read ARCHITECTURE.md §2-3 and src/scenewise/: the import-linter layers service > (adapters | app) > ports > domain each have a directory, so domain, app, adapters and service were registered as layers ahead of package (src, which keeps ports.py and the top-level modules); tests and the general catch-all are unchanged.",
      "at": "2026-10-09"
    }
  },
  "layers": [
    {
      "name": "domain",
      "path": "src/scenewise/domain",
      "conventions": ".claude/context/domain.md"
    },
    {
      "name": "app",
      "path": "src/scenewise/app",
      "conventions": ".claude/context/app.md"
    },
    {
      "name": "adapters",
      "path": "src/scenewise/adapters",
      "conventions": ".claude/context/adapters.md"
    },
    {
      "name": "service",
      "path": "src/scenewise/service",
      "conventions": ".claude/context/service.md"
    },
    {
      "name": "package",
      "path": "src",
      "conventions": ".claude/context/package.md"
    },
    {
      "name": "tests",
      "path": "tests",
      "conventions": ".claude/context/tests.md"
    },
    {
      "name": "general",
      "path": ".",
      "conventions": ".claude/context/conventions.md"
    }
  ],
  "commands": {
    "typecheck": "bash harness-scripts/typecheck.sh",
    "test": "bash harness-scripts/test.sh",
    "depInstall": "bash harness-scripts/bootstrap.sh"
  },
  "phases": {
    "qa": false,
    "docs": true,
    "parity": false
  },
  "docs": {
    "root": "docs"
  }
}
